# Локально (docker compose нижче) або рядок з MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/business_os
MONGODB_URI=mongodb://localhost:27017/business_os?replicaSet=rs0
# Довгий випадковий рядок (від 32 символів у production). Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=4000
NODE_ENV=development
# Адреси фронтенду для CORS (через кому). Потрібно лише якщо фронтенд НЕ проксує /api
CLIENT_ORIGIN=http://localhost:5173
# true, якщо фронтенд і API на різних доменах без проксі
CROSS_SITE=false
# Папка для файлів. На хостингу вкажіть шлях постійного диска, напр. /var/data/uploads
UPLOAD_DIR=uploads
# Для npm run seed:admin
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Власник
